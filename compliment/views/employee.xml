<odoo>

    <record model="ir.actions.act_window" id="employee_action">
        <field name="name">Employees</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee</field>
        <field name="context">{'search_default_active':1}</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="compliment_root_menu"
              name="Compliment"

                  />
    <menuitem name="Compliment App"
              id="compliment_menu"
              parent="compliment_root_menu"
                  />
    <menuitem name="Employees"
              id="employees_menu"
              parent="compliment_menu"
              action="employee_action"
    />

    <record id="employee_tree_view" model="ir.ui.view">
            <field name="name">employee.tree.view</field>
            <field name="model">employee</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <button name="send_mail"
                            string="Send Compliment"
                            type="object"
                            class="btn-primary"/>
                </tree>
            </field>
    </record>

    <record id="employee_search_view" model="ir.ui.view">
            <field name="name">employee.search</field>
            <field name="model">employee</field>

            <field name="arch" type="xml">
                <search string="Filter">
                    <field name="name"/>
                    <separator/>
                    <filter string="Active"
                            name="active"
                            domain="[('status', '=', 'active')]"/>
                </search>
            </field>
        </record>

</odoo>