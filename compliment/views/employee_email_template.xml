<?xml version="1.0" encoding="UTF-8"?>


<odoo>

        <record id="template" model="mail.template">
            <field name="name">Employee Template Name</field>
            <field name="model_id" ref="compliment.model_employee"/>

            <field name="email_from">{{ user.email }}</field>
            <field name="email_to">{{ object.email or '' }}</field>
            <field name="subject">Compliment for {{ object.name }}</field>
            <field name="body_html" type="html">
                <h1>Hello</h1>
            </field>
        </record>

</odoo>